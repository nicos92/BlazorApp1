@page "/tarimas/nueva_tarima"
@using BlazorApp1.Components.Shared
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject NavigationManager Navigation
@inject IBarcodeParserService BarcodeParser
@inject ITarimaValidatorService TarimaValidator
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Nueva Tarima - Sistema de Tarimas</PageTitle>

<div class="container my-5">
    @if (error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="DismissAlert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                <h3 class="mb-4">Formulario de Nueva Tarima</h3>

                @if (success)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-check-circle me-2"></i>¡Tarima registrada correctamente!
                        <button type="button" class="btn-close" @onclick="DismissAlert" aria-label="Close"></button>
                    </div>
                }

                <p class="text-muted mb-4">Complete los campos siguientes para registrar una nueva tarima en el sistema
                </p>

                <EditForm Model="tarimaModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="d-flex mb-2 justify-content-start">
                        <div>
                            <a href="/dashboard" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Volver al Panel
                            </a>
                            <a href="/tarimas" class="btn btn-outline-info me-2">
                                <i class="fas fa-list me-2"></i>Ver Tarimas
                            </a>
                        </div>
                    </div>

                    <div class="input-group has-validation mb-3">
                        <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                        <input type="text" maxlength="30" id="codigoBarras"
                               class="form-control @(codigoBarrasError != null ? "is-invalid" : "")"
                               value="@tarimaModel.CodigoBarrasLong" placeholder="Código de Barras"
                               @oninput="OnCodigoBarrasChanged" @ref="codigoBarrasInput" />
                        <ValidationMessage For="@(() => tarimaModel.CodigoBarras)" />
                    </div>
                    @if (codigoBarrasError != null)
                    {
                        <div class="text-danger mb-3">
                            <i class="fas fa-exclamation-circle me-1"></i>@codigoBarrasError
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <div class="input-group has-validation mb-3">
                                <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                <InputNumber id="numeroProducto" class="form-control" readonly
                                             @bind-Value="tarimaModel.NumeroProductoInt" placeholder="Número de Producto" />
                                <ValidationMessage For="@(() => tarimaModel.NumeroProducto)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group has-validation mb-3">
                                <span class="input-group-text"><i class="fas fa-warehouse"></i></span>
                                <InputNumber id="numeroTarima" class="form-control" readonly
                                             @bind-Value="tarimaModel.NumeroTarimaInt" placeholder="Número de Tarima" />
                                <ValidationMessage For="@(() => tarimaModel.NumeroTarima)" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="input-group has-validation mb-3">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <InputNumber id="numeroUsuario" class="form-control" readonly
                                             @bind-Value="tarimaModel.NumeroUsuarioInt" placeholder="Número de Usuario" />
                                <ValidationMessage For="@(() => tarimaModel.NumeroUsuario)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group has-validation mb-3">
                                <span class="input-group-text"><i class="fas fa-boxes"></i></span>
                                <InputNumber id="cantidadCajas" class="form-control" readonly
                                             @bind-Value="tarimaModel.CantidadCajas" placeholder="Cantidad de Cajas" min="1"
                                             max="999" />
                                <ValidationMessage For="@(() => tarimaModel.CantidadCajas)" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="input-group has-validation mb-3">
                                <span class="input-group-text"><i class="fas fa-weight"></i></span>
                                <InputNumber id="peso" class="form-control" readonly @bind-Value="tarimaModel.Peso"
                                             placeholder="Peso (kg)" min="0" max="9999.99" step="0.01" />
                                <ValidationMessage For="@(() => tarimaModel.Peso)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group has-validation mb-3">
                                <span class="input-group-text"><i class="fas fa-tags"></i></span>
                                <input type="text" id="numeroVenta" class="form-control" maxlength="9"
                                       value="@numeroVentaValue" @oninput="OnNumeroVentaChanged"
                                       @ref="numeroVentaInput" placeholder="XX-XXXXXX" />
                                <ValidationMessage For="@(() => tarimaModel.NumeroVenta)" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="descripcion" class="form-label">Descripción</label>
                        <textarea id="descripcion" class="form-control" @bind="tarimaModel.Descripcion" rows="3"
                                  placeholder="Descripción adicional de la tarima"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-submit btn-lg btn-focus-animation" disabled="@(!isFormReady)">
                            <i class="fas fa-save me-2"></i>Guardar Tarima
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private TarimaModel tarimaModel = new();
    private string? error;
    private string? errorMessage;
    private bool success = false;
    private string? codigoBarrasError;
    private ElementReference codigoBarrasInput;
    private ElementReference numeroVentaInput;

    private bool barcodeAutocompleted = false;
    private bool isFormReady = false;
    private string numeroVentaValue = "";

    private void DismissAlert()
    {
        error = null;
        errorMessage = null;
        success = false;
    }

    private async Task OnCodigoBarrasChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;

        if (value.Length >= 30)
        {
            value = value.Substring(0, 30);
            tarimaModel.CodigoBarras = value;
        }

        if (value.Length == 30)
        {
            var validationError = BarcodeParserService.GetValidationError(value);
            
            if (validationError != null)
            {
                codigoBarrasError = validationError;
                barcodeAutocompleted = false;
                isFormReady = false;
                StateHasChanged();
                return;
            }

            var parseResult = BarcodeParser.Parse(value);
            
            if (!parseResult.IsValid)
            {
                codigoBarrasError = parseResult.ErrorMessage;
                barcodeAutocompleted = false;
                isFormReady = false;
                StateHasChanged();
                return;
            }

            codigoBarrasError = null;
            tarimaModel.NumeroProducto = parseResult.NumeroProducto;
            tarimaModel.NumeroTarima = parseResult.NumeroTarima;
            tarimaModel.NumeroUsuario = parseResult.NumeroUsuario;
            tarimaModel.CantidadCajas = parseResult.CantidadCajas;
            tarimaModel.Peso = parseResult.Peso;
            
            numeroVentaValue = parseResult.NumeroVentaPrefijo;
            tarimaModel.NumeroVenta = numeroVentaValue;

            barcodeAutocompleted = true;
            isFormReady = false;
            StateHasChanged();
            await numeroVentaInput.FocusAsync();
        }
        else
        {
            codigoBarrasError = null;
            barcodeAutocompleted = false;
            isFormReady = false;
            numeroVentaValue = "";
            StateHasChanged();
        }
    }

    private void OnNumeroVentaChanged(ChangeEventArgs e)
    {
        numeroVentaValue = e.Value?.ToString() ?? "";
        
        if (numeroVentaValue.Length > 9)
        {
            numeroVentaValue = numeroVentaValue.Substring(0, 9);
        }
        
        tarimaModel.NumeroVenta = numeroVentaValue;
        
        isFormReady = TarimaValidator.IsFormReady(
            barcodeAutocompleted,
            codigoBarrasError,
            tarimaModel.CantidadCajas,
            numeroVentaValue);
        
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        var validationResult = TarimaValidator.ValidateForSubmit(tarimaModel, tarimaModel.CodigoBarras, numeroVentaValue);

        if (!validationResult.IsValid)
        {
            error = validationResult.ErrorCode;
            errorMessage = validationResult.ErrorMessage;
            return;
        }

        tarimaModel.NumeroVenta = numeroVentaValue;

        await Task.Delay(500);

        success = true;
        tarimaModel = new TarimaModel();
        codigoBarrasError = null;
        barcodeAutocompleted = false;
        isFormReady = false;
        numeroVentaValue = "";

        await Task.Delay(500);
        success = false;
        StateHasChanged();

        await codigoBarrasInput.FocusAsync();
    }
}
