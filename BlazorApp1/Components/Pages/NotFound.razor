@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Página No Encontrada - Sistema de Tarimas</PageTitle>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center">
                <div class="mb-4">
                    <i class="fas fa-map-signs fa-10x text-muted"></i>
                </div>
                <h1 class="display-1 fw-bold text-primary">404</h1>
                <h2 class="mb-3">¡Ups! Página no encontrada</h2>
                <p class="text-muted mb-4">
                    La página que estás buscando no existe o ha sido movida.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="/" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Volver al Inicio
                    </a>
                    <a href="/dashboard" class="btn btn-outline-primary">
                        <i class="fas fa-th-large me-2"></i>Panel de Control
                    </a>
                    <a href="/tarimas" class="btn btn-outline-primary">
                        <i class="fas fa-boxes me-2"></i>Ver Tarimas
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fa-10x {
        font-size: 8rem;
    }
</style>
