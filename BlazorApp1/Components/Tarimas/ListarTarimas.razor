@page "/tarimas"
@using BlazorApp1.Application.Services
@using BlazorApp1.Components.Shared
@using BlazorApp1.Entities
@inject NavigationManager Navigation
@inject ITarimaService TarimaService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Inventario de Tarimas - Sistema de Tarimas</PageTitle>

<div class="container my-5">
    @if (showPrintFilters)
    {
        <div class="print-filters">
            <h4>Filtros Aplicados:</h4>
            <ul>
                @if (!string.IsNullOrEmpty(filtros.NumeroProducto))
                {
                    <li><strong>Producto:</strong> @filtros.NumeroProducto</li>
                }
                @if (!string.IsNullOrEmpty(filtros.NumeroTarima))
                {
                    <li><strong>Tarima:</strong> @filtros.NumeroTarima</li>
                }
                @if (!string.IsNullOrEmpty(filtros.NumeroUsuario))
                {
                    <li><strong>Usuario:</strong> @filtros.NumeroUsuario</li>
                }
                @if (!string.IsNullOrEmpty(filtros.NumeroVenta))
                {
                    <li><strong>Venta:</strong> @filtros.NumeroVenta</li>
                }
                @if (filtros.FechaRegistro.HasValue)
                {
                    <li><strong>Fecha de Registro:</strong> @filtros.FechaRegistro.Value.ToString("dd/MM/yyyy")</li>
                }
                @if (!string.IsNullOrEmpty(filtros.Legajo))
                {
                    <li><strong>Legajo:</strong> @filtros.Legajo</li>
                }
                @if (!string.IsNullOrEmpty(filtros.NombreUsuario))
                {
                    <li><strong>Nombre de Usuario:</strong> @filtros.NombreUsuario</li>
                }
                @if (filtros.CantidadCajasMin.HasValue)
                {
                    <li><strong>Cajas Mínimas:</strong> @filtros.CantidadCajasMin</li>
                }
                @if (filtros.PesoMin.HasValue)
                {
                    <li><strong>Peso Mínimo:</strong> @filtros.PesoMin kg</li>
                }
            </ul>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex flex-column align-items-start no-print">
            <div class="d-flex justify-content-between w-100 align-items-center flex-wrap gap-2">
                <h3 class="mb-0">Inventario de Tarimas</h3>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/tarimas/nueva_tarima" class="btn btn-light">
                        <i class="fas fa-plus me-2"></i>Nueva Tarima
                    </a>
                    <a href="/dashboard" class="btn btn-light">
                        <i class="fas fa-arrow-left me-2"></i>Volver al Panel
                    </a>
                    <button type="button" class="btn btn-light" @onclick="Print">
                        <i class="fas fa-print me-2"></i>Imprimir
                    </button>
                </div>
            </div>
            <div class="mt-2 d-flex flex-wrap gap-2">
                <span class="badge text-bg-warning">Tarimas ingresadas hoy: <strong>@tarimasHoy</strong></span>
                <span class="badge text-bg-info">Tarimas mostradas: <strong>@tarimas.Count()</strong></span>
            </div>
        </div>

        <div class="card-body border-bottom no-print">
            <h5 class="mb-3" @onclick="ToggleFiltros" style="cursor: pointer;">
                <i class="fas fa-filter me-2"></i>
                Filtros de Búsqueda
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor"
                     class="bi bi-arrow-down-short @(showFiltros ? "" : "rotate-180")" viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                          d="M8 4a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5 10.293V4.5A.5.5 0 0 1 8 4" />
                </svg>
            </h5>

            @if (showFiltros)
            {
                <div class="collapse show">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="numero_producto" class="form-label">Producto</label>
                            <InputNumber id="numero_producto" class="form-control" @bind-Value="filtros.NumeroProductoInt"
                                         placeholder="Buscar por producto" />
                        </div>
                        <div class="col-md-3">
                            <label for="numero_tarima" class="form-label">Tarima</label>
                            <InputNumber id="numero_tarima" class="form-control" @bind-Value="filtros.NumeroTarimaInt"
                                         placeholder="Buscar por número" />
                        </div>
                        <div class="col-md-3">
                            <label for="numero_usuario" class="form-label">Usuario</label>
                            <InputNumber id="numero_usuario" class="form-control" @bind-Value="filtros.NumeroUsuarioInt"
                                         placeholder="Buscar por usuario" />
                        </div>
                        <div class="col-md-3">
                            <label for="numero_venta" class="form-label">Venta</label>
                            <InputText id="numero_venta" class="form-control" @bind-Value="filtros.NumeroVenta"
                                       placeholder="Buscar por venta" />
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-3">
                            <label for="fecha_registro" class="form-label">Fecha de Registro</label>
                            <InputDate id="fecha_registro" class="form-control" @bind-Value="filtros.FechaRegistro" />
                        </div>
                        <div class="col-md-3">
                            <label for="legajo" class="form-label">Legajo</label>
                            <InputText id="legajo" class="form-control" @bind-Value="filtros.Legajo"
                                       placeholder="Buscar por legajo" />
                        </div>
                        <div class="col-md-3">
                            <label for="nombre_usuario" class="form-label">Nombre de Usuario</label>
                            <InputText id="nombre_usuario" class="form-control" @bind-Value="filtros.NombreUsuario"
                                       placeholder="Buscar por nombre" />
                        </div>
                        <div class="col-md-3">
                            <label for="cantidad_cajas_min" class="form-label">Cajas Mínimas</label>
                            <InputNumber id="cantidad_cajas_min" class="form-control" @bind-Value="filtros.CantidadCajasMin"
                                         placeholder="Mínimo de cajas" />
                        </div>
                        <div class="col-md-3">
                            <label for="peso_min" class="form-label">Peso Mínimo</label>
                            <InputNumber id="peso_min" class="form-control" @bind-Value="filtros.PesoMin"
                                         placeholder="Peso mínimo (kg)" />
                        </div>
                    </div>
                    <div class="row g-3 mt-3">
                        <div class="col-12">
                            <button type="button" class="btn btn-primary" @onclick="AplicarFiltros">
                                <i class="fas fa-search me-2"></i>Filtrar
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                                <i class="fas fa-eraser me-2"></i>Limpiar Filtros
                            </button>
                            <button type="button" class="btn btn-success" @onclick="VerTarimasDeHoy">
                                <i class="fas fa-calendar-day me-2"></i>Ver Tarimas de Hoy
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card-body p-0">
            <div class="table-responsive d-none d-xl-block">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Tarima</th>
                            <th>Usuario</th>
                            <th>Cajas</th>
                            <th>Peso</th>
                            <th>Venta</th>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th class="no-print">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (tarimas.Any())
                        {
                            @foreach (var tarima in tarimas)
                            {
                                <tr>
                                    <td>@tarima.NumeroProducto</td>
                                    <td>@tarima.NumeroTarima</td>
                                    <td>@tarima.NumeroUsuario</td>
                                    <td>@tarima.CantidadCajas</td>
                                    <td>@tarima.Peso.ToString("F2")</td>
                                    <td>@tarima.NumeroVenta</td>
                                    <td>@tarima.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>@tarima.Descripcion</td>
                                    <td class="no-print">
                                        <a href="/tarimas/editar_tarima/@tarima.Id" class="btn btn-sm btn-outline-warning"
                                               title="Editar tarima">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted">No hay tarimas registradas para los filtros seleccionados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-xl-none">
                @if (tarimas.Any())
                {
                    <div class="row g-3 p-3">
                        @foreach (var tarima in tarimas)
                        {
                            <div class="col-12 col-sm-12 col-md-4 col-lg-3">
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h5 class="card-title">
                                                <span class="badge bg-primary">Tarima: @tarima.NumeroTarima</span>
                                            </h5>
                                            <a href="/tarimas/editar_tarima/@tarima.Id"
                                                       class="btn btn-sm btn-outline-warning no-print" title="Editar tarima">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                        <div class="card-text">
                                            <p class="mb-1"><strong>Producto:</strong> @tarima.NumeroProducto</p>
                                            <p class="mb-1"><strong>Usuario:</strong> @tarima.NumeroUsuario</p>
                                            <p class="mb-1"><strong>Cajas:</strong> @tarima.CantidadCajas</p>
                                            <p class="mb-1"><strong>Peso:</strong> @tarima.Peso.ToString("F2")</p>
                                            <p class="mb-1"><strong>Venta:</strong> @tarima.NumeroVenta</p>
                                            <p class="mb-1"><strong>Fecha:</strong> @tarima.FechaCreacion.ToString("dd/MM/yyyy")</p>
                                            <p class="mb-1"><strong>Descripción:</strong> @tarima.Descripcion</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-3">
                        <p class="text-center text-muted">No hay tarimas registradas para los filtros seleccionados.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Tarima> tarimas = new List<Tarima>();
    private TarimaFiltros filtros = new();
    private bool showFiltros = true;
    private bool showPrintFilters = false;
    private int tarimasHoy = 0;

    protected override async Task OnInitializedAsync()
    {
        filtros.FechaRegistro = DateTime.Today;
        await CargarTarimas();
    }

    private async Task CargarTarimas()
    {
        tarimas = await TarimaService.FilterTarimasAsync(
            numeroProducto: filtros.NumeroProducto,
            numeroTarima: filtros.NumeroTarima,
            numeroUsuario: filtros.NumeroUsuario,
            numeroVenta: filtros.NumeroVenta,
            fechaRegistro: filtros.FechaRegistro,
            legajo: filtros.Legajo,
            nombreUsuario: filtros.NombreUsuario,
            cantidadCajasMin: filtros.CantidadCajasMin,
            pesoMin: filtros.PesoMin);
        
        tarimasHoy = await TarimaService.GetTarimasCountByDateAsync(DateTime.Today);
    }

    private void ToggleFiltros()
    {
        showFiltros = !showFiltros;
    }

    private async Task AplicarFiltros()
    {
        showPrintFilters = true;
        await CargarTarimas();
    }

    private async Task LimpiarFiltros()
    {
        filtros = new TarimaFiltros { FechaRegistro = DateTime.Today };
        showPrintFilters = false;
        await CargarTarimas();
    }

    private async Task VerTarimasDeHoy()
    {
        filtros = new TarimaFiltros { FechaRegistro = DateTime.Today };
        showPrintFilters = false;
        await CargarTarimas();
    }

    private void Print()
    {
        JS.InvokeVoidAsync("window.print");
    }

    public class TarimaFiltros
    {
        public int? NumeroProductoInt { get; set; }
        public string NumeroProducto => NumeroProductoInt?.ToString() ?? "";

        public int? NumeroTarimaInt { get; set; }
        public string NumeroTarima => NumeroTarimaInt?.ToString() ?? "";

        public int? NumeroUsuarioInt { get; set; }
        public string NumeroUsuario => NumeroUsuarioInt?.ToString() ?? "";

        public string NumeroVenta { get; set; } = "";
        public DateTime? FechaRegistro { get; set; }
        public string Legajo { get; set; } = "";
        public string NombreUsuario { get; set; } = "";
        public int? CantidadCajasMin { get; set; }
        public decimal? PesoMin { get; set; }
    }
}
