@page "/counter"
@rendermode InteractiveServer

<div class="container-fluid" style="min-height: 100dvh;">
    <PageTitle>Counter</PageTitle>

    <h1>Counter</h1>

    <p role="status">Current count: @currentCount</p>

    <button class="btn btn-primary" @onclick="IncrementCount">Click me to increment</button>
    <button class="btn btn-primary" @onclick="ResetCount">Click me to reset</button>

</div>
@code {
    private int currentCount = 0;

    private void IncrementCount() => currentCount++;

    private void ResetCount() => currentCount = 0;
}
