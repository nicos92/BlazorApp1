@page "/auth/login"
@using System.Security.Claims
@using BlazorApp1.Components.Shared
@using BlazorApp1.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Iniciar Sesión - Sistema de Tarimas</PageTitle>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card p-4">
                <div class="card-header text-center">
                    <h3 class="mb-0 text-dark">Iniciar Sesión</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @GetErrorMessage()
                        </div>
                    }

                    <EditForm Model="loginModel" OnSubmit="HandleLogin" FormName="@LoginFormName">

                        <div class="mb-3">
                            <label for="username" class="form-label">Nombre de Usuario</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="text" id="username" class="form-control" @bind="loginModel.Username"
                                       @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Contraseña</label>
                            <div class="input-group position-relative">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="@passwordType" id="password" class="form-control"
                                       @bind="loginModel.Password" @bind:event="oninput" />
                                <button type="button"
                                        class="password-toggle position-absolute end-0 top-50 translate-middle-y pe-3 border-0 bg-transparent"
                                        style="cursor: pointer; z-index: 5;" @onclick="TogglePassword">
                                    <i class="@toggleIconClass"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox id="remember" class="form-check-input" @bind-Value="loginModel.RememberMe" />
                            <label class="form-check-label" for="remember">Recordarme</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Iniciar Sesión
                        </button>
                    </EditForm>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private static readonly string LoginFormName = "loginForm";
    private string errorMessage = "";
    private bool showPassword = false;
    private bool isLoading = false;
    private string passwordType = "password";
    private string toggleIconClass = "fas fa-eye-slash";

    private string GetErrorMessage()
    {
        return errorMessage switch
        {
            "invalid_credentials" => "Credenciales incorrectas. Por favor, verifique su nombre de usuario y contraseña.",
            "empty_fields" => "Por favor, complete todos los campos.",
            "inactive_user" => "El usuario está inactivo. Por favor, contacte con el administrador.",
            _ => "Error al iniciar sesión."
        };
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
        passwordType = showPassword ? "text" : "password";
        toggleIconClass = showPassword ? "fas fa-eye" : "fas fa-eye-slash";
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Username))
        {
            errorMessage = "empty_fields";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "empty_fields";
            return;
        }

        errorMessage = "";
        isLoading = true;
        
        try
        {
            var result = await AuthStateProvider.LoginAsync(loginModel.Username, loginModel.Password);

            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = result.ErrorCode ?? "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al intentar iniciar sesión. Por favor, intente nuevamente.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Logout()
    {
        AuthStateProvider.Logout();
        Navigation.NavigateTo("/auth/login", forceLoad: true);
    }

    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }
}
