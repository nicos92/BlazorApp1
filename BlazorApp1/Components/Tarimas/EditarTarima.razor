@page "/tarimas/editar_tarima/{id:int}"
@using BlazorApp1.Application.Services
@using BlazorApp1.Components.Shared
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject NavigationManager Navigation
@inject ITarimaService TarimaService
@inject IBarcodeParserService BarcodeParser
@inject ITarimaValidatorService TarimaValidator
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Editar Tarima - Sistema de Tarimas</PageTitle>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                <h3 class="mb-4">Formulario de Edición de Tarima</h3>

                @if (error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>@errorMessage
                        <button type="button" class="btn-close" @onclick="DismissAlert" aria-label="Close"></button>
                    </div>
                }

                @if (success)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-check-circle me-2"></i>¡Tarima actualizada correctamente!
                        <button type="button" class="btn-close" @onclick="DismissAlert" aria-label="Close"></button>
                    </div>
                }

                @if (isLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                }
                else if (tarima != null)
                {
                    <EditForm Model="tarima" OnValidSubmit="HandleUpdate">
                        <DataAnnotationsValidator />

                        <div class="d-flex mb-2 justify-content-start">
                            <div>
                                <a href="/tarimas" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Volver al Inventario
                                </a>
                            </div>
                        </div>

                        <div class="input-group has-validation mb-3">
                            <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                            <input type="text" maxlength="30" id="codigoBarras"
                                   class="form-control @(codigoBarrasError != null ? "is-invalid" : "")"
                                   value="@tarima.CodigoBarrasLong" placeholder="Código de Barras"
                                   @oninput="OnCodigoBarrasChanged" @ref="codigoBarrasInput" />
                            <ValidationMessage For="@(() => tarima.CodigoBarras)" />
                        </div>
                        @if (codigoBarrasError != null)
                        {
                            <div class="text-danger mb-3">
                                <i class="fas fa-exclamation-circle me-1"></i>@codigoBarrasError
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group has-validation mb-3">
                                    <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                    <InputNumber id="numeroProducto" class="form-control" readonly
                                                 @bind-Value="tarima.NumeroProductoInt" placeholder="Número de Producto" />
                                    <ValidationMessage For="@(() => tarima.NumeroProducto)" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group has-validation mb-3">
                                    <span class="input-group-text"><i class="fas fa-warehouse"></i></span>
                                    <InputNumber id="numeroTarima" class="form-control" readonly
                                                 @bind-Value="tarima.NumeroTarimaInt" placeholder="Número de Tarima" />
                                    <ValidationMessage For="@(() => tarima.NumeroTarima)" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group has-validation mb-3">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <InputNumber id="numeroUsuario" class="form-control" readonly
                                                 @bind-Value="tarima.NumeroUsuarioInt" placeholder="Número de Usuario" />
                                    <ValidationMessage For="@(() => tarima.NumeroUsuario)" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group has-validation mb-3">
                                    <span class="input-group-text"><i class="fas fa-boxes"></i></span>
                                    <InputNumber id="cantidadCajas" class="form-control" readonly
                                                 @bind-Value="tarima.CantidadCajas" placeholder="Cantidad de Cajas" min="1"
                                                 max="999" />
                                    <ValidationMessage For="@(() => tarima.CantidadCajas)" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group has-validation mb-3">
                                    <span class="input-group-text"><i class="fas fa-weight"></i></span>
                                    <InputNumber id="peso" class="form-control" readonly @bind-Value="tarima.Peso"
                                                 placeholder="Peso (kg)" min="0" max="9999.99" step="0.01" />
                                    <ValidationMessage For="@(() => tarima.Peso)" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-group has-validation mb-3">
                                    <span class="input-group-text"><i class="fas fa-tags"></i></span>
                                    <input type="text" id="numeroVenta" class="form-control" maxlength="9"
                                           value="@numeroVentaValue" @oninput="OnNumeroVentaChanged" @ref="numeroVentaInput"
                                           placeholder="XX-XXXXXX" />
                                    <ValidationMessage For="@(() => tarima.NumeroVenta)" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label">Descripción</label>
                            <textarea id="descripcion" class="form-control" @bind="tarima.Descripcion" rows="3"
                                      placeholder="Descripción adicional de la tarima"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/tarimas" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Volver al Inventario
                            </a>
                            <button type="submit" class="btn btn-submit btn-lg btn-focus-animation"
                                    disabled="@(!isFormReady)">
                                <i class="fas fa-save me-2"></i>Actualizar Tarima
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>La tarima no fue encontrada.
                    </div>
                    <a href="/tarimas" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Volver al Inventario
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private TarimaModel? tarima;
    private string? error;
    private string? errorMessage;
    private bool success = false;
    private bool isLoading = true;
    private string? codigoBarrasError;
    private ElementReference codigoBarrasInput;
    private ElementReference numeroVentaInput;

    private bool barcodeAutocompleted = false;
    private bool isFormReady = false;
    private string numeroVentaValue = "";

    private void DismissAlert()
    {
        error = null;
        errorMessage = null;
        success = false;
    }

    protected override async Task OnInitializedAsync()
    {
        var tarimas = await TarimaService.GetAllTarimasAsync();
        var existingTarima = tarimas.FirstOrDefault(t => t.Id == Id);

        if (existingTarima != null)
        {
            tarima = new TarimaModel
            {
                Id = existingTarima.Id,
                CodigoBarras = existingTarima.CodigoBarras,
                NumeroProducto = existingTarima.NumeroProducto,
                NumeroTarima = existingTarima.NumeroTarima,
                NumeroUsuario = existingTarima.NumeroUsuario,
                CantidadCajas = existingTarima.CantidadCajas,
                Peso = existingTarima.Peso,
                NumeroVenta = existingTarima.NumeroVenta,
                Descripcion = existingTarima.Descripcion ?? string.Empty
            };
            numeroVentaValue = existingTarima.NumeroVenta;
            
            if (!string.IsNullOrEmpty(tarima.CodigoBarras) && tarima.CodigoBarras.Length == 30)
            {
                barcodeAutocompleted = true;
                isFormReady = TarimaValidator.IsFormReady(true, null, tarima.CantidadCajas, numeroVentaValue);
            }
        }

        isLoading = false;
    }

    private async Task OnCodigoBarrasChanged(ChangeEventArgs e)
    {
        if (tarima == null) return;
        
        var value = e.Value?.ToString() ?? string.Empty;

        if (value.Length >= 30)
        {
            value = value.Substring(0, 30);
            tarima.CodigoBarras = value;
        }

        if (value.Length == 30)
        {
            var validationError = BarcodeParserService.GetValidationError(value);
            
            if (validationError != null)
            {
                codigoBarrasError = validationError;
                barcodeAutocompleted = false;
                isFormReady = false;
                StateHasChanged();
                return;
            }

            var parseResult = BarcodeParser.Parse(value);
            
            if (!parseResult.IsValid)
            {
                codigoBarrasError = parseResult.ErrorMessage;
                barcodeAutocompleted = false;
                isFormReady = false;
                StateHasChanged();
                return;
            }

            codigoBarrasError = null;
            tarima.NumeroProducto = parseResult.NumeroProducto;
            tarima.NumeroTarima = parseResult.NumeroTarima;
            tarima.NumeroUsuario = parseResult.NumeroUsuario;
            tarima.CantidadCajas = parseResult.CantidadCajas;
            tarima.Peso = parseResult.Peso;
            
            numeroVentaValue = parseResult.NumeroVentaPrefijo;
            tarima.NumeroVenta = numeroVentaValue;

            barcodeAutocompleted = true;
            isFormReady = false;
            StateHasChanged();
            await numeroVentaInput.FocusAsync();
        }
        else
        {
            codigoBarrasError = null;
            barcodeAutocompleted = false;
            isFormReady = false;
            numeroVentaValue = "";
            StateHasChanged();
        }
    }

    private void OnNumeroVentaChanged(ChangeEventArgs e)
    {
        numeroVentaValue = e.Value?.ToString() ?? "";
        
        if (numeroVentaValue.Length > 9)
        {
            numeroVentaValue = numeroVentaValue.Substring(0, 9);
        }
        
        if (tarima != null)
        {
            tarima.NumeroVenta = numeroVentaValue;
        }
        
        isFormReady = TarimaValidator.IsFormReady(
            barcodeAutocompleted,
            codigoBarrasError,
            tarima?.CantidadCajas ?? 0,
            numeroVentaValue);
        
        StateHasChanged();
    }

    private async Task HandleUpdate()
    {
        if (tarima == null) return;

        var validationResult = TarimaValidator.ValidateForSubmit(tarima, tarima.CodigoBarras, numeroVentaValue);

        if (!validationResult.IsValid)
        {
            error = validationResult.ErrorCode;
            errorMessage = validationResult.ErrorMessage;
            return;
        }

        tarima.NumeroVenta = numeroVentaValue;

        await Task.Delay(500);

        success = true;

        await Task.Delay(2000);
        Navigation.NavigateTo("/tarimas");
    }
}
